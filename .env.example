# Credenciais do Google Cloud (caminho para o JSON da service account)
GOOGLE_APPLICATION_CREDENTIALS=./gcp/credenciais.json

# BigQuery
BQ_PROJECT=seu-projeto-gcp
BQ_DATASET=nome_do_dataset

# Diretório local onde os CSVs baixados serão salvos
DADOS_DIR=./data/camara_leg_csv

# API de dados abertos da Câmara
URL_BASE=https://dadosabertos.camara.leg.br/arquivos